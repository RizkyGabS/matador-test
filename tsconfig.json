{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "esModuleInterop": true,
        "outDir": "./dist",
        "strict": true
    },
    "ts-node": {
    "esm": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}